#!/usr/bin/env python3
"""
mcorechat - simple ncurses chat client for MeshCore companion radios.

Left pane lists channels and contacts, right pane shows the selected
conversation, the bottom line is the message input.

Keys:
  Up / Down      select channel / contact
  PgUp / PgDn    scroll message history
  Enter          send message
  Tab            complete a /command; otherwise focus the message list
                 (Up/Down select a message, Enter shows details, Tab/Esc back)
  F3             choose a device to connect to (serial / BLE), or disconnect
  F4             send an advert (zero hop or flood)
  F5             reload contacts and channels from the radio
  F6             show / hide repeaters in the contact list
  F7             log console
  F8             contact menu (details, ping, trace, path, remove)
  F2             settings (name, TX power, auto-add contacts, repeaters)
  F1             help
  Readline keys in the input: ^A ^E ^B ^F ^D ^U ^K ^W ^Y; ^P / ^N switch conversation
  F10            quit (asks for confirmation)
  Ctrl-Q, Ctrl-C quit immediately

Commands (type in the input line, /help lists them):
  /channel <name> [secret-hex]   create a channel (#name joins a public hashtag channel)
  /quit /connect /disconnect /advert [zero|flood] /trace <hops> /log /reload /settings /repeaters /help
  Start a message with // to send a literal leading slash.

Usage:
  mcorechat [--port /dev/ttyUSB0]
  mcorechat --ble <ADDRESS>

The app starts disconnected; press F3 to pick a device and connect.
"""

import argparse
import asyncio
import curses
import locale
import os
import collections
import glob
import json
import logging
import textwrap
from dataclasses import dataclass, field
from datetime import datetime

from serial.tools import list_ports
from meshcore import MeshCore, SerialConnection, BLEConnection
from meshcore.events import EventType

DEFAULT_PORT = '/dev/ttyUSB0'
CONFIG_FILE = os.path.expanduser('~/.config/mcorechat/config.json')
SIDEBAR_W = 24
MAX_CHANNELS = 8
BLE_UART_UUID = '6e400001-b5a3-f393-e0a9-e50e24dcca9e'
NODE_TYPES = {1: 'client', 2: 'repeater', 3: 'room'}
CTRL_Q, CTRL_C = 17, 3
LOG_LINES = 1000


def load_config() -> dict:
    try:
        with open(CONFIG_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def describe_error(payload: dict) -> str:
    """Human-readable reason for a radio ERROR event (payload may be empty)."""
    if payload.get('code_string'):
        return payload['code_string']
    if payload.get('reason'):
        return payload['reason']
    if payload.get('error'):
        return str(payload['error'])
    if 'error_code' in payload:
        return f'error code {payload["error_code"]}'
    return 'radio rejected the command (no error code)'


class LogBuffer(logging.Handler):
    """Collects log records (ours and the meshcore library's) for the F7 log view."""

    def __init__(self):
        super().__init__(logging.INFO)
        self.lines: collections.deque[str] = collections.deque(maxlen=LOG_LINES)
        self.setFormatter(logging.Formatter('%(asctime)s %(levelname)-7s %(name)s: %(message)s',
                                            '%H:%M:%S'))

    def emit(self, record):
        try:
            self.lines.extend(self.format(record).splitlines())
        except Exception:
            pass


LOG = LogBuffer()
log = logging.getLogger('mcorechat')


@dataclass
class Msg:
    ts: int
    who: str
    text: str
    mine: bool = False
    status: str = ''   # '' | 'sent' | 'acked' | 'failed'
    recv: int = 0                          # local time we saw it
    info: dict = field(default_factory=dict)   # raw radio fields for the details view


def hhmm(ts: int) -> str:
    return datetime.fromtimestamp(ts or datetime.now().timestamp()).strftime('%H:%M')


class App:
    @property
    def status(self) -> str:
        return self._status

    @property
    def show_repeaters(self) -> bool:
        return self._show_repeaters

    @show_repeaters.setter
    def show_repeaters(self, value: bool):
        self._show_repeaters = value
        self.save_config()

    def save_config(self):
        cfg = {'show_repeaters': self._show_repeaters, 'auto_connect': self.auto_connect,
               'port': self.args.port, 'ble': self.args.ble}
        try:
            os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
            with open(CONFIG_FILE, 'w') as f:
                json.dump(cfg, f, indent=2)
        except OSError as e:
            log.warning('could not save config: %s', e)

    @status.setter
    def status(self, text: str):
        self._status = text
        log.info(text)

    def __init__(self, args):
        self.args = args
        self.mc: MeshCore | None = None
        self.connecting = False
        self.contact_cache: dict = {}        # last known contacts, kept after disconnect
        self.channels: list[tuple[int, str]] = []
        self.history: dict[tuple, list[Msg]] = {}
        self.unread: dict[tuple, int] = {}
        self.selected: tuple | None = None
        cfg = load_config()
        self._show_repeaters = bool(cfg.get('show_repeaters', False))
        self.auto_connect = bool(cfg.get('auto_connect', False))
        self.scroll = 0                      # lines scrolled up from bottom
        self.buf = ''
        self.pos = 0
        self.status = 'disconnected'
        self.pending_acks: dict[str, Msg] = {}
        self.dirty = True
        self.quit = False
        self.settings_open = False
        self.set_sel = 0
        self.picker_open = False
        self.focus = 'input'                 # 'input' | 'msgs'
        self.msg_sel = 0
        self.last_body_h = 0
        self.details: list[str] | None = None
        self.details_title = 'Message details'
        self.cmenu_open = False
        self.cmenu_sel = 0
        self.advert_menu_open = False
        self.advert_sel = 0
        self.ask: dict | None = None         # single-line input prompt: label/text/cb
        self.confirm_remove: dict | None = None
        self.help_open = False
        self.help_scroll = 0
        self.log_open = False
        self.log_scroll = 0
        self.radio_lock = asyncio.Lock()     # the library can't tell concurrent replies apart
        self.kill = ''                       # readline kill ring (one slot)
        self.confirm_quit = False
        self.picker_items: list[tuple[str, str, str]] = []   # (kind, address, label)
        self.picker_sel = 0
        self.picker_note = ''
        self.scan_task: asyncio.Task | None = None
        self.set_edit: str | None = None     # text being edited, None when not editing

    # ---- conversation model ------------------------------------------------

    def contact_entries(self) -> list[tuple[tuple, str]]:
        """Contacts (plus unknown senders we have history with), newest first."""
        out = []
        known = set()
        contacts = sorted(self.contacts().values(),
                          key=lambda c: -c.get('last_advert', 0))
        for c in contacts:
            key = ('d', c['public_key'][:12])
            known.add(key)
            is_rep = c.get('type') == 2
            if is_rep and not self.show_repeaters and key not in self.history:
                continue
            tag = '*' if is_rep else ''
            out.append((key, tag + (c.get('adv_name') or c['public_key'][:8])))
        for key in self.history:
            if key and key[0] == 'd' and key not in known:
                out.append((key, key[1][:8]))
        return out

    def entries(self) -> list[tuple[tuple, str]]:
        ch = [(('c', i), n) for i, n in self.channels]
        return ch + self.contact_entries()

    def name_for(self, key: tuple) -> str:
        for k, n in self.entries():
            if k == key:
                return n
        return key[1][:8] if key[0] == 'd' else f'ch{key[1]}'

    def add(self, key: tuple, msg: Msg):
        msgs = self.history.setdefault(key, [])
        msgs.append(msg)
        if key == self.selected:
            self.scroll = 0
            if self.focus == 'msgs' and self.msg_sel == len(msgs) - 2:
                self.msg_sel = len(msgs) - 1
        else:
            self.unread[key] = self.unread.get(key, 0) + 1
        self.dirty = True

    def select(self, key: tuple):
        self.selected = key
        self.focus = 'input'
        self.unread.pop(key, None)
        self.scroll = 0
        self.dirty = True

    def move(self, delta: int):
        ents = self.entries()
        if not ents:
            return
        keys = [k for k, _ in ents]
        i = keys.index(self.selected) if self.selected in keys else -1
        self.select(keys[max(0, min(len(keys) - 1, i + delta))])

    def contacts(self) -> dict:
        return self.mc.contacts if self.mc else self.contact_cache

    # ---- connection --------------------------------------------------------

    def target(self) -> str:
        return self.args.ble or self.args.port

    async def toggle_connection(self):
        if self.connecting:
            return
        if self.mc:
            await self.disconnect()
        else:
            self.open_picker()

    # ---- device picker -----------------------------------------------------

    def open_picker(self):
        self.picker_open = True
        self.picker_sel = 0
        self.rescan()

    def close_picker(self):
        self.picker_open = False
        if self.scan_task:
            self.scan_task.cancel()
            self.scan_task = None

    def rescan(self):
        if self.scan_task:
            self.scan_task.cancel()
        labels = {p.device: p.description for p in list_ports.comports()}
        ports = sorted(glob.glob('/dev/ttyUSB*') + glob.glob('/dev/ttyACM*'))
        self.picker_items = [
            ('serial', p, f'{p}  {labels[p]}' if labels.get(p, 'n/a') != 'n/a' else p)
            for p in ports]
        self.picker_note = 'scanning for BLE devices...'
        self.scan_task = asyncio.create_task(self.scan_ble())
        self.dirty = True

    async def scan_ble(self):
        try:
            from bleak import BleakScanner
            devs = await BleakScanner.discover(timeout=5.0, service_uuids=[BLE_UART_UUID])
        except asyncio.CancelledError:
            raise
        except Exception:
            self.picker_note = 'BLE unavailable'
        else:
            self.picker_items += [('ble', d.address, f'BLE {d.address}  {d.name or "?"}')
                                  for d in devs]
            self.picker_note = '' if self.picker_items else 'no devices found'
        self.dirty = True

    def start_auto_connect(self):
        self.connect_to('ble' if self.args.ble else 'serial', self.target())

    def connect_to(self, kind: str, addr: str):
        if kind == 'ble':
            self.args.ble = addr
        else:
            self.args.ble, self.args.port = None, addr
        self.connecting = True
        self.status = f'connecting to {addr}...'
        self.dirty = True
        asyncio.create_task(self.connect())

    async def handle_picker_key(self, k):
        n = len(self.picker_items)
        if k in ('\x1b', curses.KEY_F3):
            self.close_picker()
        elif k == curses.KEY_UP:
            self.picker_sel = max(0, self.picker_sel - 1)
        elif k == curses.KEY_DOWN:
            self.picker_sel = max(0, min(n - 1, self.picker_sel + 1))
        elif k in ('r', 'R'):
            self.rescan()
        elif k == '\n' and n:
            kind, addr, _ = self.picker_items[self.picker_sel]
            self.close_picker()
            self.connect_to(kind, addr)
        elif isinstance(k, str) and len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C):
            self.quit = True
        self.dirty = True

    async def connect(self):
        mc = None
        try:
            cx = (BLEConnection(address=self.args.ble) if self.args.ble
                  else SerialConnection(self.args.port, 115200))
            mc = MeshCore(cx)
            await mc.connect()
            if mc.self_info is None:
                raise RuntimeError('no response from radio')
            self.mc = mc
            # announce protocol v3: the radio then reports SNR with each received message
            r = await mc.commands.send_device_query()
            log.info('device query: %s', 'ok' if r.type != EventType.ERROR else describe_error(r.payload))
            await self.load()
            mc.subscribe(EventType.CONTACT_MSG_RECV, self.on_contact_msg)
            mc.subscribe(EventType.CHANNEL_MSG_RECV, self.on_chan_msg)
            mc.subscribe(EventType.ACK, self.on_ack)
            for ev in (EventType.NEW_CONTACT, EventType.ADVERTISEMENT, EventType.PATH_UPDATE):
                mc.subscribe(ev, self.on_contacts_changed)
            await self.log_autoadd_config()
            mc.subscribe(EventType.DISCONNECTED, self.on_disconnected)
            await mc.start_auto_message_fetching()
            self.save_config()
            self.status = f'connected to {self.target()}'
        except BaseException as e:
            self.mc = None
            if mc is not None:
                try:
                    await mc.disconnect()
                except Exception:
                    pass
            if isinstance(e, asyncio.CancelledError):
                raise
            self.status = f'connect failed: {str(e) or type(e).__name__}'
        finally:
            self.connecting = False
            self.dirty = True

    async def disconnect(self, reason: str = 'disconnected'):
        mc, self.mc = self.mc, None
        if mc is None:
            return
        self.contact_cache = dict(mc.contacts)
        self.pending_acks.clear()
        self.status = reason
        self.dirty = True
        try:
            await mc.disconnect()
        except Exception:
            pass

    async def on_disconnected(self, event):
        # device unplugged / link lost; skip our own manual disconnect
        if self.mc is not None:
            asyncio.create_task(self.disconnect('connection lost'))

    def need_radio(self) -> bool:
        if self.mc is None:
            self.status = 'not connected'
            self.dirty = True
            return False
        return True

    # ---- radio events ------------------------------------------------------

    async def load_channels(self) -> int | None:
        """Refresh self.channels from the radio; returns the first free slot, if any."""
        chans, free = [], None
        for idx in range(MAX_CHANNELS):
            r = await self.mc.commands.get_channel(idx)
            if r.type == EventType.ERROR:
                break
            name = r.payload.get('channel_name', '')
            if name:
                chans.append((idx, name))
            elif free is None:
                free = idx
        self.channels = chans
        self.dirty = True
        return free

    async def create_channel(self, arg: str):
        """/channel <name> [secret-hex]: #name = public hashtag channel, otherwise private."""
        if not self.need_radio():
            return
        parts = arg.split()
        if not parts or len(parts) > 2:
            self.status = 'usage: /channel <name> [32-hex-char secret]'
            return
        name = parts[0]
        if len(name.encode()) > 31:
            self.status = 'channel name too long (max 31 bytes)'
            return
        secret = None
        if len(parts) == 2:
            try:
                secret = bytes.fromhex(parts[1])
            except ValueError:
                secret = b''
            if len(secret) != 16:
                self.status = 'secret must be 32 hex characters (16 bytes)'
                return
        elif not name.startswith('#'):
            secret = os.urandom(16)          # private channel: random key, share it by hand
        if any(n == name for _, n in self.channels):
            self.status = f'channel {name} already exists'
            return
        free = await self.load_channels()
        if free is None:
            self.status = 'no free channel slot on the radio'
            return
        r = await self.mc.commands.set_channel(free, name, secret)
        if r.type == EventType.ERROR:
            self.status = f'create channel failed: {describe_error(r.payload)}'
            return
        await self.load_channels()
        self.select(('c', free))
        if name.startswith('#'):
            self.note(f'joined public channel {name} (slot {free})')
        else:
            self.note(f'created channel {name} (slot {free}); secret: '
                      f'{secret.hex() if secret else "derived from name"}')
        self.status = f'channel {name} created'

    async def load(self):
        await self.mc.ensure_contacts()
        await self.load_channels()
        if self.selected is None and (e := self.entries()):
            self.select(e[0][0])
        self.dirty = True

    def on_contact_msg(self, event):
        p = event.payload
        prefix = p.get('pubkey_prefix', '')[:12]
        c = self.mc.get_contact_by_key_prefix(prefix) if prefix else None
        who = c['adv_name'] if c else prefix[:8]
        self.add(('d', prefix), Msg(p.get('sender_timestamp', 0), who, p.get('text', ''),
                                    recv=int(datetime.now().timestamp()), info=dict(p)))

    def on_chan_msg(self, event):
        p = event.payload
        # channel text already arrives as "sender: message"
        self.add(('c', p.get('channel_idx', 0)),
                 Msg(p.get('sender_timestamp', 0), '', p.get('text', ''),
                     recv=int(datetime.now().timestamp()), info=dict(p)))

    def on_ack(self, event):
        m = self.pending_acks.pop(event.payload.get('code', ''), None)
        if m:
            m.status = 'acked'
            self.dirty = True

    async def on_contacts_changed(self, event):
        # the library only marks its contact table dirty on adverts; fetch the new entries
        mc = self.mc
        if mc is not None:
            log.info('%s: %s', event.type.value, str(event.payload.get('public_key', ''))[:12])
            try:
                async with self.radio_lock:
                    await mc.ensure_contacts(follow=True)
            except Exception as e:
                log.warning('contact refresh failed: %s', e)
        self.dirty = True

    async def log_autoadd_config(self):
        try:
            r = await self.mc.commands.get_autoadd_config()
            log.info('autoadd config: %s', r.payload)
        except Exception as e:
            log.info('autoadd config unavailable: %s', e)

    async def send(self, text: str):
        key = self.selected
        if key is None or not text or not self.need_radio():
            return
        now = int(datetime.now().timestamp())
        msg = Msg(now, 'me', text, mine=True, recv=now)
        self.add(key, msg)
        contact = None
        if key[0] == 'd':
            contact = self.mc.get_contact_by_key_prefix(key[1])
            if contact is None:
                msg.status = 'failed'
                self.status = 'unknown contact'
                return
        async with self.radio_lock:
            for attempt in (1, 2):
                if key[0] == 'c':
                    r = await self.mc.commands.send_chan_msg(key[1], text)
                else:
                    r = await self.mc.commands.send_msg(contact, text)
                if r.type != EventType.ERROR:
                    break
                log.warning('send attempt %d to %s failed: %s %s', attempt,
                            self.name_for(key), describe_error(r.payload), r.payload)
                if attempt == 1:
                    await asyncio.sleep(1)       # transient busy/queue-full: retry once
        if r.type == EventType.MSG_SENT:
            msg.status = 'sent'
            msg.info = dict(r.payload)
            code = r.payload.get('expected_ack')
            if key[0] == 'd' and code:
                self.pending_acks[code if isinstance(code, str) else code.hex()] = msg
        else:
            msg.status = 'failed'
            self.status = f'send failed: {describe_error(r.payload)}'
        self.dirty = True

    # ---- settings ----------------------------------------------------------

    SETTINGS = ('port', 'autoconnect', 'name', 'tx_power', 'auto_add', 'repeaters')

    def setting_rows(self) -> list[tuple[str, str]]:
        si = (self.mc.self_info if self.mc else None) or {}
        onoff = lambda b: 'on' if b else 'off'
        dash = lambda k: str(si[k]) if k in si else '-'
        return [
            ('BLE address' if self.args.ble else 'Serial port', self.target()),
            ('Connect on startup', onoff(self.auto_connect)),
            ('Device name', dash('name')),
            ('TX power (dBm)', dash('tx_power')),
            ('Auto add discovered contacts',
             onoff(not si['manual_add_contacts']) if 'manual_add_contacts' in si else '-'),
            ('Show repeaters in list', onoff(self.show_repeaters)),
        ]

    async def apply_setting(self, which: str, text: str | None = None):
        if which == 'repeaters':
            self.show_repeaters = not self.show_repeaters
            return
        if which == 'autoconnect':
            self.auto_connect = not self.auto_connect
            self.save_config()
            self.status = f'connect on startup: {"on" if self.auto_connect else "off"}'
            return
        if which == 'port':
            if text:
                if self.args.ble:
                    self.args.ble = text
                else:
                    self.args.port = text
                self.save_config()
                self.status = f'target set to {text} (takes effect on next connect)'
            return
        if not self.need_radio():
            return
        si = self.mc.self_info
        cmds = self.mc.commands
        if which == 'auto_add':
            manual = not si.get('manual_add_contacts', False)
            r = await cmds.set_manual_add_contacts(manual)
            ok_val = ('manual_add_contacts', manual)
        elif which == 'name' and text:
            r = await cmds.set_name(text)
            ok_val = ('name', text)
        elif which == 'tx_power' and text:
            try:
                dbm = int(text)
            except ValueError:
                self.status = 'TX power must be a number'
                return
            r = await cmds.set_tx_power(dbm)
            ok_val = ('tx_power', dbm)
        else:
            return
        if r.type == EventType.ERROR:
            self.status = f'setting failed: {describe_error(r.payload)}'
        else:
            self.mc.self_info[ok_val[0]] = ok_val[1]   # library may have replaced the dict
            self.status = 'saved'

    async def handle_settings_key(self, k):
        which = self.SETTINGS[self.set_sel]
        if self.set_edit is not None:
            if k == '\n':
                text, self.set_edit = self.set_edit.strip(), None
                await self.apply_setting(which, text)
            elif k == '\x1b':
                self.set_edit = None
            elif k in ('\x7f', '\b') or k == curses.KEY_BACKSPACE:
                self.set_edit = self.set_edit[:-1]
            elif isinstance(k, str) and k.isprintable():
                self.set_edit += k
        elif k in ('\x1b', curses.KEY_F2):
            self.settings_open = False
        elif k == curses.KEY_UP:
            self.set_sel = max(0, self.set_sel - 1)
        elif k == curses.KEY_DOWN:
            self.set_sel = min(len(self.SETTINGS) - 1, self.set_sel + 1)
        elif k == '\n':
            if which in ('port', 'name', 'tx_power'):
                if which != 'port' and not self.need_radio():
                    return
                self.set_edit = ''
            else:
                await self.apply_setting(which)
        elif isinstance(k, str) and len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C):
            self.quit = True
        self.dirty = True

    # ---- slash commands ----------------------------------------------------

    def note(self, text: str):
        """Local-only line in the current conversation (never sent)."""
        self.history.setdefault(self.selected, []).append(
            Msg(0, '*', text, mine=True))
        self.scroll = 0
        self.dirty = True

    COMMAND_NAMES = ('advert', 'channel', 'connect', 'contact', 'disconnect', 'help', 'quit', 'reload',
                     'log', 'repeaters', 'settings', 'trace')

    def complete(self):
        """Tab completion for /commands in the input line."""
        if not self.buf.startswith('/') or ' ' in self.buf or self.buf.startswith('//'):
            return
        word = self.buf[1:].lower()
        hits = [c for c in self.COMMAND_NAMES if c.startswith(word)]
        if not hits:
            self.status = f'no command matches /{word}'
            return
        common = os.path.commonprefix(hits)
        self.buf = '/' + common
        self.pos = len(self.buf)
        if len(hits) > 1:
            self.status = 'matches: ' + '  '.join('/' + c for c in hits)

    async def submit(self, text: str):
        if not text:
            return
        if not text.startswith('/') or text.startswith('//'):
            await self.send(text[1:] if text.startswith('//') else text)
            return
        name, _, arg = text[1:].partition(' ')
        name = name.lower()
        if name in ('contact', 'ct'):
            self.open_contact_menu()
            self.dirty = True
            return
        if name in ('a', 'advert'):
            kinds = {'': None, 'zero': False, 'zerohop': False, '0': False, 'flood': True}
            if arg.strip().lower() not in kinds:
                self.status = 'usage: /advert [zero|flood]'
            else:
                await self.advert(kinds[arg.strip().lower()])
            self.dirty = True
            return
        if name in ('t', 'trace'):
            await self.trace_command(arg)
            self.dirty = True
            return
        if name in ('ch', 'channel'):
            await self.create_channel(arg.strip())
            self.dirty = True
            return
        cmds = {
            ('q', 'quit', 'exit'): lambda: setattr(self, 'quit', True),
            ('c', 'connect'): self.pick_device,
            ('d', 'disconnect'): self.disconnect,
            ('r', 'reload'): self.reload,
            ('s', 'settings'): lambda: setattr(self, 'settings_open', True),
            ('l', 'log', 'console'): self.open_log,
            ('repeaters',): lambda: setattr(self, 'show_repeaters', not self.show_repeaters),
            ('h', 'help', '?'): self.help,
        }
        for names, fn in cmds.items():
            if name in names:
                r = fn()
                if asyncio.iscoroutine(r):
                    await r
                self.dirty = True
                return
        self.status = f'unknown command /{name} (try /help)'

    async def trace_command(self, arg: str):
        """/trace hop,hop,... where a hop is a 1-byte hex hash or a repeater name."""
        toks = [t for t in arg.replace(',', ' ').split() if t]
        if not toks:
            self.status = 'usage: /trace <hop,hop,...>  (hex hash or repeater name)'
            return
        if not self.need_radio():
            return
        route = []
        for t in toks:
            if len(t) == 2 and all(ch in '0123456789abcdefABCDEF' for ch in t):
                route.append(t.lower())
                continue
            hits = [c for c in self.contacts().values()
                    if c.get('type') in (2, 3) and t.lower() in c.get('adv_name', '').lower()]
            if len(hits) != 1:
                self.status = (f'no repeater matches "{t}"' if not hits
                               else f'"{t}" is ambiguous ({len(hits)} repeaters)')
                return
            route.append(hits[0]['public_key'][:2])
        self.status = 'tracing...'
        self.dirty = True

        async def go():
            lines = [f'path: {" > ".join(route)}', ''] + await self.run_trace(route)
            self.show('Trace', lines)
            self.status = 'trace done'
        asyncio.create_task(self.guarded(go()))

    def open_log(self):
        self.log_open, self.log_scroll = True, 0

    async def pick_device(self):
        if self.mc:
            await self.disconnect()
        self.open_picker()

