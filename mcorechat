    # ---- input -------------------------------------------------------------

    async def handle_key(self, k):
        if self.details is not None:
            self.details = None
            self.dirty = True
            return
        if self.help_open:
            if k == curses.KEY_UP:
                self.help_scroll = max(0, self.help_scroll - 1)
            elif k == curses.KEY_DOWN:
                self.help_scroll += 1
            elif k == curses.KEY_PPAGE:
                self.help_scroll = max(0, self.help_scroll - 10)
            elif k == curses.KEY_NPAGE:
                self.help_scroll += 10
            else:
                self.help_open = False
            self.dirty = True
            return
        if self.confirm_quit:
            if k in ('y', 'Y', '\n'):
                self.quit = True
            elif k in ('n', 'N', '\x1b', curses.KEY_F10):
                self.confirm_quit = False
            self.dirty = True
            return
        if self.ask:
            await self.handle_ask_key(k)
            return
        if self.confirm_remove:
            if k in ('y', 'Y'):
                c, self.confirm_remove = self.confirm_remove['contact'], None
                await self.apply_remove(c)
            elif k in ('n', 'N', '\x1b', '\n'):
                self.confirm_remove = None
            self.dirty = True
            return
        if self.cmenu_open:
            await self.handle_cmenu_key(k)
            return
        if self.advert_menu_open:
            await self.handle_advert_key(k)
            return
        if k == curses.KEY_F10:
            self.confirm_quit = True
            self.dirty = True
            return
        if k == curses.KEY_F8 and not (self.picker_open or self.settings_open or self.log_open):
            self.open_contact_menu()
            self.dirty = True
            return
        if k == curses.KEY_F1:
            self.help_open, self.help_scroll = True, 0
            self.dirty = True
            return
        if self.log_open:
            self.handle_log_key(k)
            return
        if k == curses.KEY_F7:
            self.log_open, self.log_scroll = True, 0
            self.dirty = True
            return
        if self.picker_open:
            await self.handle_picker_key(k)
            return
        if k == curses.KEY_F2 and not self.settings_open:
            self.settings_open = True
            self.dirty = True
            return
        if self.settings_open:
            await self.handle_settings_key(k)
            return
        if self.focus == 'msgs' and self.handle_msg_focus_key(k):
            return
        if isinstance(k, str):
            o = ord(k) if len(k) == 1 else -1
            if k == '\n':
                text, self.buf, self.pos = self.buf.strip(), '', 0
                await self.submit(text)
            elif o in (CTRL_Q, CTRL_C):
                self.quit = True
            elif k == '\t':
                if self.buf.startswith('/') and ' ' not in self.buf:
                    self.complete()
                elif self.history.get(self.selected):
                    self.focus = 'msgs'
                    self.msg_sel = len(self.history[self.selected]) - 1
            elif k in ('\x7f', '\b'):
                if self.pos:
                    self.buf = self.buf[:self.pos - 1] + self.buf[self.pos:]
                    self.pos -= 1
            elif o == 1:                       # ^A  home
                self.pos = 0
            elif o == 5:                       # ^E  end
                self.pos = len(self.buf)
            elif o == 2:                       # ^B  back
                self.pos = max(0, self.pos - 1)
            elif o == 6:                       # ^F  forward
                self.pos = min(len(self.buf), self.pos + 1)
            elif o == 4:                       # ^D  delete char
                self.buf = self.buf[:self.pos] + self.buf[self.pos + 1:]
            elif o == 21:                      # ^U  kill to start of line
                self.kill, self.buf, self.pos = self.buf[:self.pos], self.buf[self.pos:], 0
            elif o == 11:                      # ^K  kill to end of line
                self.kill, self.buf = self.buf[self.pos:], self.buf[:self.pos]
            elif o == 23:                      # ^W  kill previous word
                start = len(self.buf[:self.pos].rstrip())
                start = self.buf.rfind(' ', 0, start) + 1
                self.kill, self.buf, self.pos = (self.buf[start:self.pos],
                                                 self.buf[:start] + self.buf[self.pos:], start)
            elif o == 25:                      # ^Y  yank
                self.buf = self.buf[:self.pos] + self.kill + self.buf[self.pos:]
                self.pos += len(self.kill)
            elif o == 16:                      # ^P  previous conversation
                self.move(-1)
            elif o == 14:                      # ^N  next conversation
                self.move(1)
            elif k.isprintable():
                self.buf = self.buf[:self.pos] + k + self.buf[self.pos:]
                self.pos += 1
        elif k == curses.KEY_UP:
            self.move(-1)
        elif k == curses.KEY_DOWN:
            self.move(1)
        elif k == curses.KEY_PPAGE:
            self.scroll += 5
        elif k == curses.KEY_NPAGE:
            self.scroll = max(0, self.scroll - 5)
        elif k == curses.KEY_LEFT:
            self.pos = max(0, self.pos - 1)
        elif k == curses.KEY_RIGHT:
            self.pos = min(len(self.buf), self.pos + 1)
        elif k == curses.KEY_HOME:
            self.pos = 0
        elif k == curses.KEY_END:
            self.pos = len(self.buf)
        elif k == curses.KEY_BACKSPACE:
            if self.pos:
                self.buf = self.buf[:self.pos - 1] + self.buf[self.pos:]
                self.pos -= 1
        elif k == curses.KEY_DC:
            self.buf = self.buf[:self.pos] + self.buf[self.pos + 1:]
        elif k == curses.KEY_F3:
            await self.toggle_connection()
        elif k == curses.KEY_F4:
            await self.advert()
        elif k == curses.KEY_F5:
            await self.reload()
        elif k == curses.KEY_F6:
            self.show_repeaters = not self.show_repeaters
        self.dirty = True

    # ---- contact actions ---------------------------------------------------

    CONTACT_ACTIONS = (
        ('Details', 'details'), ('Ping (zero hop)', 'ping'), ('Trace path', 'trace'),
        ('Discover route', 'discover'), ('Set path...', 'setpath'),
        ('Reset path', 'resetpath'), ('Remove contact', 'remove'),
    )

    def selected_contact(self) -> dict | None:
        key = self.selected
        if not key or key[0] != 'd':
            return None
        return next((v for k, v in self.contacts().items() if k.startswith(key[1])), None)

    def open_contact_menu(self):
        if self.selected_contact() is None:
            self.status = 'select a contact first' if (self.selected or ('x',))[0] != 'd' \
                else 'not in the contact list'
            return
        self.cmenu_open, self.cmenu_sel = True, 0

    def hop_name(self, h: str) -> str:
        """Name for a path hash (repeaters preferred, since those are what relay)."""
        hits = [c for c in self.contacts().values() if c['public_key'].startswith(h.lower())]
        hits.sort(key=lambda c: c.get('type') != 2)
        return f'{hits[0]["adv_name"]} ({h})' if hits else h

    @staticmethod
    def hops_of(path_hex: str, n: int) -> list[str]:
        return [path_hex[i:i + 2] for i in range(0, n * 2, 2)]

    def contact_details(self, c: dict) -> list[str]:
        fmt = lambda t: datetime.fromtimestamp(t).strftime('%Y-%m-%d %H:%M:%S') if t else 'never'
        n = c.get('out_path_len', -1)
        if n in (-1, 255):
            route = 'flood (no stored path)'
        elif n == 0:
            route = 'direct'
        else:
            route = f'{n} hop(s): ' + ' > '.join(
                self.hop_name(h) for h in self.hops_of(c.get('out_path', ''), n))
        rows = [('Name', c.get('adv_name', '?')),
                ('Type', NODE_TYPES.get(c.get('type'), '?')),
                ('Public key', c['public_key']),
                ('Last advert', fmt(c.get('last_advert', 0))),
                ('Route', route)]
        lat, lon = c.get('adv_lat'), c.get('adv_lon')
        if lat or lon:
            rows.append(('Position', f'{lat:.5f}, {lon:.5f}'))
        out = []
        for a, b in rows:
            lines = textwrap.wrap(b, 52, break_long_words=True) or ['']
            out.append(f'{a + ":":<14}{lines[0]}')
            out += [' ' * 14 + l for l in lines[1:]]
        return out

    def show(self, title: str, lines: list[str]):
        self.details_title, self.details = title, lines
        self.dirty = True

    async def run_trace(self, hops: list[str]) -> list[str]:
        """Send a trace over the given 1-byte hop hashes; returns result lines."""
        async with self.radio_lock:
            r = await self.mc.commands.send_trace(path=','.join(hops))
        if r.type == EventType.ERROR:
            return [f'trace not sent: {describe_error(r.payload)}']
        tag = int.from_bytes(r.payload['expected_ack'], 'little')
        timeout = r.payload.get('suggested_timeout', 10000) / 1000 + 5
        ev = await self.mc.wait_for_event(EventType.TRACE_DATA,
                                          attribute_filters={'tag': tag}, timeout=timeout)
        if ev is None:
            return ['no reply (timed out)',
                    'Only repeaters and room servers answer traces; the node may be out of range.']
        nodes = ev.payload.get('path', [])
        out = []
        for i, nd in enumerate(nodes):
            who = self.hop_name(nd['hash']) if 'hash' in nd else 'this radio'
            out.append(f'hop {i + 1}: {who:<30} SNR {nd["snr"]:.2f} dB' if 'snr' in nd
                       else f'hop {i + 1}: {who}')
        complete = sum('snr' in nd for nd in nodes) >= len(hops)
        out.append('' if out else 'empty reply')
        out.append('REACHABLE' if complete else 'incomplete path')
        return out

    async def contact_action(self, action: str):
        c = self.selected_contact()
        if c is None:
            return
        name = c.get('adv_name', '?')
        if action == 'details':
            self.show(f'Contact: {name}', self.contact_details(c))
            return
        if action == 'remove':
            self.confirm_remove = {'contact': c}
            self.dirty = True
            return
        if action == 'setpath':
            self.ask = {'label': f'New path for {name} (hex hops, e.g. 78,64; empty = direct)',
                        'text': '', 'cb': self.apply_set_path, 'contact': c}
            self.dirty = True
            return
        if not self.need_radio():
            return
        asyncio.create_task(self.guarded(self.contact_radio_action(action, c)))

    async def guarded(self, coro):
        try:
            await coro
        except asyncio.CancelledError:
            raise
        except Exception as e:
            log.exception('action failed')
            self.status = f'failed: {e}'
            self.dirty = True

    async def contact_radio_action(self, action: str, c: dict):
        name, key = c.get('adv_name', '?'), c['public_key']
        n = c.get('out_path_len', -1)
        hops = self.hops_of(c.get('out_path', ''), n) if n not in (-1, 255) else []
        relay = c.get('type') in (2, 3)
        if action == 'ping':
            self.status = f'pinging {name}...'
            self.dirty = True
            lines = await self.run_trace([key[:2]])
            self.show(f'Ping: {name}', lines)
        elif action == 'trace':
            if not hops and not relay:
                self.status = 'no stored path to trace (try Discover route)'
                return
            route = hops + ([key[:2]] if relay else []) + hops[::-1]
            self.status = f'tracing {name}...'
            self.dirty = True
            lines = [f'path: {" > ".join(route)}', ''] + await self.run_trace(route)
            self.show(f'Trace: {name}', lines)
        elif action == 'discover':
            self.status = f'discovering route to {name}...'
            self.dirty = True
            async with self.radio_lock:
                ev = await self.mc.commands.send_path_discovery_sync(c, min_timeout=15)
            if not ev:
                self.show(f'Route: {name}', ['no response'])
                return
            p = ev.payload
            lines = []
            for label, k in (('Out', 'out_path'), ('In', 'in_path')):
                cnt = p.get(f'{k}_len', 0)
                hs = self.hops_of(p.get(k, ''), cnt)
                lines.append(f'{label}: {cnt} hop(s)' + (': ' + ' > '.join(self.hop_name(h) for h in hs) if hs else ''))
            self.show(f'Route: {name}', lines)
            self.status = 'route discovered'
        elif action == 'resetpath':
            async with self.radio_lock:
                r = await self.mc.commands.reset_path(key)
            self.status = (f'path reset for {name}' if r.type != EventType.ERROR
                           else f'reset failed: {describe_error(r.payload)}')
        self.dirty = True

    async def apply_set_path(self, text: str, c: dict):
        parts = [p for p in text.replace(' ', '').lower().replace(',', ' ').split() if p]
        if any(len(p) != 2 or any(ch not in '0123456789abcdef' for ch in p) for p in parts):
            self.status = 'path must be 1-byte hex hops, e.g. 78,64'
            return
        if not self.need_radio():
            return
        async with self.radio_lock:
            r = await self.mc.commands.change_contact_path(c, ''.join(parts))
        self.status = (f'path set for {c.get("adv_name", "?")}' if r.type != EventType.ERROR
                       else f'set path failed: {describe_error(r.payload)}')

    async def apply_remove(self, c: dict):
        if not self.need_radio():
            return
        async with self.radio_lock:
            r = await self.mc.commands.remove_contact(c['public_key'])
        if r.type == EventType.ERROR:
            self.status = f'remove failed: {describe_error(r.payload)}'
            return
        self.mc.contacts.pop(c['public_key'], None)
        self.status = f'removed {c.get("adv_name", "?")}'
        ents = self.contact_entries() or self.entries()
        if ents:
            self.select(ents[0][0])

    async def handle_cmenu_key(self, k):
        n = len(self.CONTACT_ACTIONS)
        if k in ('\x1b', curses.KEY_F8):
            self.cmenu_open = False
        elif k == curses.KEY_UP:
            self.cmenu_sel = max(0, self.cmenu_sel - 1)
        elif k == curses.KEY_DOWN:
            self.cmenu_sel = min(n - 1, self.cmenu_sel + 1)
        elif k == '\n':
            self.cmenu_open = False
            await self.contact_action(self.CONTACT_ACTIONS[self.cmenu_sel][1])
        elif isinstance(k, str) and len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C):
            self.quit = True
        self.dirty = True

    async def handle_ask_key(self, k):
        a = self.ask
        if k == '\x1b':
            self.ask = None
        elif k == '\n':
            self.ask = None
            await a['cb'](a['text'], a['contact'])
        elif k in ('\x7f', '\b') or k == curses.KEY_BACKSPACE:
            a['text'] = a['text'][:-1]
        elif isinstance(k, str) and k.isprintable():
            a['text'] += k
        self.dirty = True

    def draw_cmenu(self, scr, h, w):
        c = self.selected_contact() or {}
        bw = min(w - 2, 40)
        bh = len(self.CONTACT_ACTIONS) + 3
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for y in range(bh):
            scr.addstr(y0 + y, x0, ' ' * bw, curses.A_REVERSE)
        scr.addnstr(y0, x0 + 1, c.get('adv_name', 'Contact'), bw - 2, curses.A_REVERSE | curses.A_BOLD)
        for i, (label, _) in enumerate(self.CONTACT_ACTIONS):
            attr = curses.A_NORMAL if i == self.cmenu_sel else curses.A_REVERSE
            scr.addnstr(y0 + 1 + i, x0 + 1, label.ljust(bw - 2), bw - 2, attr)
        scr.addnstr(y0 + bh - 1, x0 + 1, 'Enter select · Esc close', bw - 2,
                    curses.A_REVERSE | curses.A_DIM)
        curses.curs_set(0)

    def draw_ask(self, scr, h, w):
        a = self.ask
        bw = min(w - 2, 70)
        y0, x0 = max(0, h // 2 - 2), max(0, (w - bw) // 2)
        for y in range(4):
            scr.addstr(y0 + y, x0, ' ' * bw, curses.A_REVERSE)
        scr.addnstr(y0, x0 + 1, a['label'], bw - 2, curses.A_REVERSE | curses.A_BOLD)
        scr.addnstr(y0 + 1, x0 + 1, (a['text'] + '_').ljust(bw - 2), bw - 2, curses.A_REVERSE)
        scr.addnstr(y0 + 3, x0 + 1, 'Enter apply · Esc cancel', bw - 2, curses.A_REVERSE | curses.A_DIM)
        curses.curs_set(0)

    # ---- message selection / details -------------------------------------

    def message_details(self, m: Msg) -> list[str]:
        key = self.selected
        info = m.info
        fmt = lambda t: datetime.fromtimestamp(t).strftime('%Y-%m-%d %H:%M:%S') if t else '-'
        rows: list[tuple[str, str]] = []
        me = (self.mc.self_info or {}).get('name', 'me') if self.mc else 'me'
        text = m.text
        if key and key[0] == 'c':
            chan = self.name_for(key)
            if m.mine:
                rows += [('From', f'{me} (you)'), ('To', f'channel {chan}')]
            else:
                sender, sep, rest = text.partition(': ')
                if sep:
                    rows.append(('From', sender))
                    text = rest
                rows.append(('Channel', f'{chan} (slot {key[1]})'))
        elif key:
            c = next((v for k2, v in self.contacts().items() if k2.startswith(key[1])), None)
            peer = self.name_for(key)
            if m.mine:
                rows += [('From', f'{me} (you)'), ('To', peer)]
            else:
                rows.append(('From', peer))
            rows.append(('Key', c['public_key'] if c else key[1]))
            if c:
                rows.append(('Node type', NODE_TYPES.get(c.get('type'), '?')))
        if m.mine:
            rows.append(('Sent', fmt(m.ts)))
            rows.append(('Status', {'sent': 'sent to radio (no ack yet)',
                                    'acked': 'delivered (ack received)',
                                    'failed': 'failed'}.get(m.status, m.status or '-')))
        elif m.info:
            rows.append(('Sent (sender clock)', fmt(info.get('sender_timestamp', 0))))
            rows.append(('Received', fmt(m.recv)))
            plen = info.get('path_len')
            if plen is not None:
                rows.append(('Route', 'direct' if plen == 255 else f'{plen} hop(s)'))
            for label, k, unit in (('SNR', 'SNR', ' dB'), ('RSSI', 'RSSI', ' dBm')):
                if k in info:
                    rows.append((label, f'{info[k]}{unit}'))
            if info.get('path'):
                rows.append(('Path', info['path']))
            if 'txt_type' in info:
                rows.append(('Text type', {0: 'plain', 1: 'command', 2: 'signed'}.get(
                    info['txt_type'], str(info['txt_type']))))
        else:
            rows.append(('Note', 'local message (not from the radio)'))
        out = [f'{a + ":":<22}{b}' for a, b in rows]
        out += ['', 'Message:']
        out += textwrap.wrap(text, 64) or ['']
        return out

    def handle_msg_focus_key(self, k) -> bool:
        """Keys while the message list has focus; returns False to fall through to the input."""
        msgs = self.history.get(self.selected, [])
        page = max(1, self.last_body_h // 2)
        if k in ('\t', '\x1b'):
            self.focus = 'input'
        elif k == curses.KEY_UP:
            self.msg_sel = max(0, self.msg_sel - 1)
        elif k == curses.KEY_DOWN:
            self.msg_sel = min(len(msgs) - 1, self.msg_sel + 1)
        elif k == curses.KEY_PPAGE:
            self.msg_sel = max(0, self.msg_sel - page)
        elif k == curses.KEY_NPAGE:
            self.msg_sel = min(len(msgs) - 1, self.msg_sel + page)
        elif k == curses.KEY_HOME:
            self.msg_sel = 0
        elif k == curses.KEY_END:
            self.msg_sel = len(msgs) - 1
        elif k == '\n' and msgs:
            self.show('Message details', self.message_details(msgs[self.msg_sel]))
        elif isinstance(k, str) and (k.isprintable() or k == '\x7f'):
            self.focus = 'input'          # start typing: back to the input line
            return False
        else:
            return False
        self.dirty = True
        return True

    def draw_details(self, scr, h, w):
        rows = self.details[:h - 4]
        bw = min(w - 2, 78)
        bh = len(rows) + 3
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for y in range(bh):
            scr.addstr(y0 + y, x0, ' ' * bw, curses.A_REVERSE)
        scr.addnstr(y0, x0 + 1, self.details_title, bw - 2, curses.A_REVERSE | curses.A_BOLD)
        for i, line in enumerate(rows):
            scr.addnstr(y0 + 1 + i, x0 + 1, line, bw - 2, curses.A_REVERSE)
        scr.addnstr(y0 + bh - 1, x0 + 1, 'press any key to close', bw - 2,
                    curses.A_REVERSE | curses.A_DIM)
        curses.curs_set(0)

    def handle_log_key(self, k):
        if k in ('\x1b', 'q', curses.KEY_F7):
            self.log_open = False
        elif k == curses.KEY_UP:
            self.log_scroll += 1
        elif k == curses.KEY_DOWN:
            self.log_scroll = max(0, self.log_scroll - 1)
        elif k == curses.KEY_PPAGE:
            self.log_scroll += 10
        elif k == curses.KEY_NPAGE:
            self.log_scroll = max(0, self.log_scroll - 10)
        elif k in (curses.KEY_END, 'G'):
            self.log_scroll = 0
        elif k == curses.KEY_HOME:
            self.log_scroll = len(LOG.lines)
        elif isinstance(k, str) and len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C):
            self.quit = True
        self.dirty = True

    def draw_log(self, scr, h, w):
        scr.erase()
        lines = []
        for l in LOG.lines:
            lines += textwrap.wrap(l, w - 1, subsequent_indent='    ') or ['']
        body = h - 2
        self.log_scroll = min(self.log_scroll, max(0, len(lines) - body))
        end = len(lines) - self.log_scroll
        for y, l in enumerate(lines[max(0, end - body):end]):
            scr.addnstr(1 + y, 0, l, w - 1)
        scr.addnstr(0, 0, ' Log'.ljust(w), w - 1, curses.A_REVERSE | curses.A_BOLD)
        scr.addnstr(h - 1, 0, ' Up/Down/PgUp/PgDn scroll  End latest  F7/Esc/q close'.ljust(w),
                    w - 1, curses.A_REVERSE)
        curses.curs_set(0)
        scr.refresh()

    # ---- drawing -----------------------------------------------------------

    def render_lines(self, width: int) -> list[tuple[str, int, int]]:
        lines = []
        for n, m in enumerate(self.history.get(self.selected, [])):
            mark = {'sent': ' ·', 'acked': ' ✓', 'failed': ' ✗'}.get(m.status, '')
            body = f'{m.who}: {m.text}' if m.who else m.text
            prefix = f'{hhmm(m.ts)} '
            attr = curses.A_DIM if m.mine else curses.A_NORMAL
            wrapped = textwrap.wrap(body + mark, max(10, width - len(prefix)),
                                    subsequent_indent='  ') or ['']
            for i, w in enumerate(wrapped):
                lines.append(((prefix if i == 0 else ' ' * len(prefix)) + w, attr, n))
        return lines

    def draw(self, scr):
        h, w = scr.getmaxyx()
        if self.log_open:
            self.draw_log(scr, h, w)
            return
        scr.erase()
        if h < 6 or w < SIDEBAR_W + 20:
            scr.addstr(0, 0, 'terminal too small'[:w - 1])
            scr.refresh()
            return
        sw = SIDEBAR_W
        mw = w - sw - 1
        body_h = h - 3                      # title row at 0, input + status at bottom

        # sidebar
        ents = self.entries()
        rows: list[tuple[str, tuple | None]] = []
        n_ch = len(self.channels)
        rows.append(('Channels', None))
        for k, n in ents[:n_ch]:
            rows.append((n, k))
        rows.append(('Contacts', None))
        for k, n in ents[n_ch:]:
            rows.append((n, k))
        sel_row = next((i for i, (_, k) in enumerate(rows) if k == self.selected), 0)
        top = max(0, min(sel_row - body_h // 2, len(rows) - body_h))
        for y, (label, key) in enumerate(rows[top:top + body_h]):
            if key is None:
                scr.addnstr(1 + y, 0, label, sw - 1, curses.A_BOLD | curses.A_UNDERLINE)
                continue
            u = self.unread.get(key, 0)
            tail = f' {u}' if u else ''
            text = ' ' + label[:sw - 3 - len(tail)]
            text = text.ljust(sw - 1 - len(tail)) + tail
            attr = curses.A_REVERSE if key == self.selected else (
                curses.A_BOLD if u else curses.A_NORMAL)
            scr.addnstr(1 + y, 0, text, sw - 1, attr)
        for y in range(1, h - 2):
            scr.addstr(y, sw, '│')

        # title
        si = (self.mc.self_info if self.mc else None) or {}
        title = f' mcorechat — {si.get("name", "disconnected")} '
        if self.selected:
            title += f'— {self.name_for(self.selected)} '
        scr.addnstr(0, 0, ' ' * w, w - 1, curses.A_REVERSE)
        scr.addnstr(0, 0, title, w - 1, curses.A_REVERSE)
        room = w - 1 - len(title) - 2
        if room > 8 and self.status:
            msg = self.status if len(self.status) <= room else self.status[:room - 1] + '…'
            scr.addnstr(0, w - 1 - len(msg) - 1, msg, room, curses.A_REVERSE)

        # messages
        lines = self.render_lines(mw)
        self.last_body_h = body_h
        if self.focus == 'msgs':
            self.msg_sel = max(0, min(self.msg_sel, len(self.history.get(self.selected, [])) - 1))
            idx = [i for i, l in enumerate(lines) if l[2] == self.msg_sel]
            if idx:                          # scroll so the highlighted message is visible
                end_now = len(lines) - self.scroll
                if idx[-1] >= end_now:
                    self.scroll = len(lines) - idx[-1] - 1
                elif idx[0] < end_now - body_h:
                    self.scroll = max(0, len(lines) - idx[0] - body_h)
        self.scroll = min(self.scroll, max(0, len(lines) - body_h))
        end = len(lines) - self.scroll
        for y, (text, attr, n) in enumerate(lines[max(0, end - body_h):end]):
            if self.focus == 'msgs' and n == self.msg_sel:
                attr = curses.A_REVERSE
            scr.addnstr(1 + y, sw + 1, text, mw, attr)
        if self.scroll:
            scr.addnstr(body_h, sw + 1, f'-- {self.scroll} lines up (PgDn) --', mw, curses.A_DIM)

        # input + status
        prompt = '> '
        vis = w - len(prompt) - 1
        start = max(0, self.pos - vis + 1)
        scr.addnstr(h - 2, 0, prompt + self.buf[start:start + vis], w - 1)
        keys = [('F1', 'Help'), ('F2', 'Settings'),
                ('F3', 'Disconnect' if self.mc else 'Connect'), ('F4', 'Advert'),
                ('F5', 'Reload'), ('F6', 'Repeaters'), ('F7', 'Log'), ('F8', 'Contact'), ('F10', 'Quit')]
        status = ' ' + '  '.join(f'{k} {v}' for k, v in keys)
        scr.addnstr(h - 1, 0, status.ljust(w), w - 1, curses.A_REVERSE)
        scr.move(h - 2, min(w - 1, len(prompt) + self.pos - start))
        curses.curs_set(0 if self.focus == 'msgs' else 1)
        if self.settings_open:
            self.draw_settings(scr, h, w)
        if self.picker_open:
            self.draw_picker(scr, h, w)
        if self.help_open:
            self.draw_help(scr, h, w)
        if self.details is not None:
            self.draw_details(scr, h, w)
        if self.cmenu_open:
            self.draw_cmenu(scr, h, w)
        if self.advert_menu_open:
            self.draw_advert_menu(scr, h, w)
        if self.ask:
            self.draw_ask(scr, h, w)
        if self.confirm_remove:
            c = self.confirm_remove['contact']
            msg = f' Remove {c.get("adv_name", "?")}?  [y] yes  [n/Esc] no '
            y0, x0 = h // 2, max(0, (w - len(msg)) // 2)
            scr.addnstr(y0, x0, msg, w - 1 - x0, curses.A_REVERSE | curses.A_BOLD)
            curses.curs_set(0)
        if self.confirm_quit:
            msg = ' Quit mcorechat?  [y/Enter] yes  [n/Esc] no '
            y0, x0 = h // 2, max(0, (w - len(msg)) // 2)
            scr.addnstr(y0, x0, msg, w - 1 - x0, curses.A_REVERSE | curses.A_BOLD)
            curses.curs_set(0)
        scr.refresh()

    def draw_picker(self, scr, h, w):
        bw = min(w - 2, 60)
        items = self.picker_items[:max(1, h - 8)]
        bh = len(items) + 4 + (1 if not items or self.picker_note else 0)
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for y in range(bh):
            scr.addstr(y0 + y, x0, ' ' * bw, curses.A_REVERSE)
        scr.addnstr(y0, x0 + 1, 'Connect to device', bw - 2, curses.A_REVERSE | curses.A_BOLD)
        y = y0 + 1
        for i, (_, _, label) in enumerate(items):
            attr = curses.A_NORMAL if i == self.picker_sel else curses.A_REVERSE
            scr.addnstr(y, x0 + 1, label.ljust(bw - 2), bw - 2, attr)
            y += 1
        note = self.picker_note or ('' if items else 'no devices found')
        if note:
            scr.addnstr(y, x0 + 1, note, bw - 2, curses.A_REVERSE | curses.A_DIM)
        scr.addnstr(y0 + bh - 1, x0 + 1, 'Enter connect · r rescan · Esc cancel', bw - 2,
                    curses.A_REVERSE | curses.A_DIM)
        curses.curs_set(0)

    def draw_settings(self, scr, h, w):
        rows = self.setting_rows()
        bw = min(w - 2, 58)
        bh = len(rows) + 4
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for y in range(bh):
            scr.addstr(y0 + y, x0, ' ' * bw, curses.A_REVERSE)
        scr.addnstr(y0, x0 + 1, 'Settings', bw - 2, curses.A_REVERSE | curses.A_BOLD)
        for i, (label, val) in enumerate(rows):
            if i == self.set_sel and self.set_edit is not None:
                val = self.set_edit + '_'
            line = f'{label:<31}{val}'
            attr = curses.A_NORMAL if i == self.set_sel else curses.A_REVERSE
            scr.addnstr(y0 + 1 + i, x0 + 1, line.ljust(bw - 2), bw - 2, attr)
        hint = 'Enter save · Esc cancel' if self.set_edit is not None else \
            'Enter change · Esc close'
        scr.addnstr(y0 + bh - 1, x0 + 1, hint, bw - 2, curses.A_REVERSE | curses.A_DIM)
        curses.curs_set(0)


async def ui(scr, app: App):
    curses.curs_set(1)
    curses.use_default_colors()
    scr.nodelay(True)
    scr.keypad(True)
    while not app.quit:
        try:
            k = scr.get_wch()
        except curses.error:
            k = None
        if k is None:
            if app.dirty:
                app.dirty = False
                app.draw(scr)
            await asyncio.sleep(0.03)
            continue
        if k == curses.KEY_RESIZE:
            app.dirty = True
            continue
        await app.handle_key(k)


async def run(scr, args):
    app = App(args)
    if app.auto_connect:
        app.start_auto_connect()
    try:
        await ui(scr, app)
    finally:
        await app.disconnect()


def main():
    ap = argparse.ArgumentParser(description='ncurses MeshCore chat client')
    ap.add_argument('--port', default=os.environ.get('MCORECHAT_PORT'))
    ap.add_argument('--ble', metavar='ADDRESS', help='connect over BLE instead of serial')
    args = ap.parse_args()
    saved = load_config()
    if not args.port and not args.ble:
        args.ble = saved.get('ble')          # remember last used target
    args.port = args.port or saved.get('port') or DEFAULT_PORT
    locale.setlocale(locale.LC_ALL, '')
    os.environ.setdefault('ESCDELAY', '25')   # ncurses waits 1000ms after Esc by default
    # keep library log output off the screen; F7 shows it
    root = logging.getLogger()
    root.handlers[:] = [LOG]
    root.setLevel(logging.INFO)

    def wrapped(scr):
        asyncio.run(run(scr, args))

    try:
        curses.wrapper(lambda scr: (curses.raw(), wrapped(scr)))
    except KeyboardInterrupt:
        pass
    except Exception as e:
        raise SystemExit(f'mcorechat: {type(e).__name__}: {e}')


if __name__ == '__main__':
    main()
