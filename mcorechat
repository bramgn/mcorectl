#!/usr/bin/env python3
"""
mcorechat - simple ncurses chat client for MeshCore companion radios.

Left pane lists channels and contacts, right pane shows the selected
conversation, the bottom line is the message input.

Keys:
  Up / Down      select channel / contact
  PgUp / PgDn    scroll message history
  Enter          send message
  Tab            complete a /command; otherwise focus the message list
                 (Up/Down select a message, Enter shows details, Tab/Esc back)
  F3             choose a device to connect to (serial / BLE), or disconnect
  F4             send an advert (zero hop or flood)
  F5             reload contacts and channels from the radio
  F6             show / hide repeaters in the contact list
  F7             Log (status messages; lights up in the sidebar on problems)
  F9             Radio (every packet heard)
  F8             contact menu (details, ping, trace, path, remove)
  F2             settings (name, TX power, auto-add contacts, repeaters)
  F1             help
  Readline keys in the input: ^A ^E ^B ^F ^D ^U ^K ^W ^Y; ^P / ^N switch conversation
  F10            quit (asks for confirmation)
  Ctrl-Q, Ctrl-C quit immediately

Commands (type in the input line, /help lists them):
  /channel <name> [secret-hex]   create a channel (#name joins a public hashtag channel)
  /quit /connect /disconnect /advert [zero|flood] /trace <hops> /log /radio /clear /reload /settings /repeaters /help
  Start a message with // to send a literal leading slash.

Usage:
  mcorechat [--port /dev/ttyUSB0]
  mcorechat --ble <ADDRESS>

The app starts disconnected; press F3 to pick a device and connect.
"""

import os
import sys

# the code lives next to this script (also when started through a symlink in ~/.local/bin)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from mcorechat_app.cli import main

if __name__ == '__main__':
    main()
