def _age_str(ts: int) -> str:
    if not ts:
        return 'never'
    secs = int(datetime.now().timestamp()) - ts
    if secs < 0:
        return 'just now'
    if secs < 3600:
        return f'{secs // 60}m ago'
    if secs < 86400:
        h, m = secs // 3600, (secs % 3600) // 60
        return f'{h}h {m:02d}m ago'
    return f'{secs // 86400}d ago'

