async def cmd_status(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    contact = mc.get_contact_by_key_prefix(args.key_prefix)
    if contact is None:
        print(f'ERROR: no contact matching {args.key_prefix}')
        await mc.disconnect()
        return

    node_type = {0: 'client', 1: 'repeater', 2: 'room'}.get(contact.get('type', -1), '?')
    print(f'  name:         {contact["adv_name"]}')
    print(f'  public key:   {contact["public_key"]}')
    print(f'  type:         {node_type}')
    print(f'  last heard:   {_age_str(contact.get("last_advert", 0))}')

    print(f'[{ts()}] Fetching status from {contact["adv_name"]}...')
    p = await mc.commands.req_status_sync(contact, min_timeout=15)
    if not p:
        print('No response.')
        await mc.disconnect()
        return
    uptime = p.get('uptime', 0)
    h, m, s = uptime // 3600, (uptime % 3600) // 60, uptime % 60
    bat_mv = p.get('bat')
    bat_str = _bat_pct(bat_mv) if bat_mv else 'n/a'
    print(f'  uptime:       {h}h {m:02d}m {s:02d}s')
    print(f'  battery:      {bat_str}')
    print(f'  noise floor:  {p.get("noise_floor", "?")} dB')
    print(f'  last RSSI:    {p.get("last_rssi", "?")} dBm  SNR {p.get("last_snr", "?")} dB')
    print(f'  tx queue:     {p.get("tx_queue_len", "?")}')
    print(f'  received:     {p.get("nb_recv", "?")}  sent: {p.get("nb_sent", "?")}')
    print(f'  flood rx/tx:  {p.get("recv_flood", "?")} / {p.get("sent_flood", "?")}')
    print(f'  direct rx/tx: {p.get("recv_direct", "?")} / {p.get("sent_direct", "?")}')
    if p.get('recv_errors') is not None:
        print(f'  recv errors:  {p["recv_errors"]}')
    await mc.disconnect()


