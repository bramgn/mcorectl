async def cmd_admin(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    contact = mc.get_contact_by_key_prefix(args.key_prefix)
    if contact is None:
        print(f'ERROR: no contact matching {args.key_prefix}')
        await mc.disconnect()
        return

    print(f'[{ts()}] Logging into {contact["adv_name"]}...')
    login = await mc.commands.send_login_sync(contact, args.password, min_timeout=15)
    if not login or login.type != EventType.LOGIN_SUCCESS:
        print('Login failed.')
        await mc.disconnect()
        return

    print(f'  Logged in. Sending command: {args.admin_cmd!r}')
    pubkey_prefix = contact['public_key'][:12]
    # Drain any stale buffered messages before sending so we only see the fresh reply
    while True:
        stale = await mc.commands.get_msg()
        if stale.type == EventType.NO_MORE_MSGS:
            break
    waiting_future = asyncio.get_event_loop().create_future()
    def _on_waiting(event):
        if not waiting_future.done():
            waiting_future.set_result(event)
    sub = mc.subscribe(EventType.MESSAGES_WAITING, _on_waiting)
    try:
        result = await mc.commands.send_cmd(contact, args.admin_cmd)
        if result.type == EventType.ERROR:
            print(f'  Send failed: {result.payload}')
            waiting_future.cancel()
        else:
            timeout_s = result.payload.get('suggested_timeout', 10000) / 1000 + 5.0
            try:
                await asyncio.wait_for(waiting_future, timeout_s)
                while True:
                    msg = await mc.commands.get_msg()
                    if msg.type == EventType.NO_MORE_MSGS:
                        break
                    if msg.type == EventType.CONTACT_MSG_RECV:
                        p = msg.payload
                        if p.get('pubkey_prefix', '').startswith(pubkey_prefix[:8]):
                            print(f'  Reply: {p.get("text", "")}')
            except asyncio.TimeoutError:
                print('  No reply.')
    finally:
        mc.unsubscribe(sub)
        await mc.commands.send_logout(contact)
    await mc.disconnect()


def _bat_pct(mv: int) -> str:
    pct = max(0, min(100, round((mv - 3000) / 1200 * 100)))
    return f'{mv} mV ({pct}%)'

async def cmd_info(args):
    cx = make_connection(args)
    mc = MeshCore(cx)

    # Subscribe before connect so MESSAGES_WAITING isn't missed
    msgs_waiting = asyncio.get_event_loop().create_future()
    def _on_msgs(event):
        if not msgs_waiting.done():
            msgs_waiting.set_result(True)
    mc.subscribe(EventType.MESSAGES_WAITING, _on_msgs)
    await mc.connect()

    core = await mc.commands.get_stats_core()

    # Brief wait to catch a MESSAGES_WAITING that may follow appstart
    try:
        await asyncio.wait_for(asyncio.shield(msgs_waiting), timeout=0.5)
    except asyncio.TimeoutError:
        pass

    si = mc.self_info
    if si:
        print(f'  name:        {si.get("name", "?")}')
        print(f'  public key:  {si.get("public_key", "?")}')

    if core and core.type != EventType.ERROR:
        p = core.payload
        uptime = p.get('uptime_secs', 0)
        h, m, s = uptime // 3600, (uptime % 3600) // 60, uptime % 60
        bat_mv = p.get('battery_mv')
        print(f'  uptime:      {h}h {m:02d}m {s:02d}s')
        print(f'  battery:     {_bat_pct(bat_mv) if bat_mv else "?"}')

    if si:
        print(f'  freq:        {si.get("radio_freq", "?")} MHz')
        print(f'  bandwidth:   {si.get("radio_bw", "?")} kHz')
        print(f'  spreading:   SF{si.get("radio_sf", "?")}')
        print(f'  coding rate: {si.get("radio_cr", "?")}')
        print(f'  tx power:    {si.get("tx_power", "?")} dBm')

    pending = msgs_waiting.done() and msgs_waiting.result()
    print(f'  messages:    {"pending (run: meshctl recv)" if pending else "none"}')

    await mc.disconnect()


