#!/usr/bin/env python3
"""
mcorectl  --  CLI for MeshCore LoRa mesh networks

Examples:
  mcorectl contacts
  mcorectl send <key_prefix> "Hello"
  mcorectl recv
  mcorectl listen
  mcorectl trace <relay>,<target>,<relay> -v
  mcorectl neighbours <key_prefix>
  mcorectl status <key_prefix>
  mcorectl route <key_prefix>
  mcorectl rxlog --log rxlog.txt
  mcorectl admin <key_prefix> advert --password <password>
  mcorectl admin <key_prefix> reboot --password <password>
"""

import argparse
import asyncio
import logging
from datetime import datetime

from meshcore import MeshCore, SerialConnection, BLEConnection
from meshcore.events import EventType

DEFAULT_PORT = '/dev/ttyUSB0'

def make_connection(args):
    if getattr(args, 'ble', None):
        return BLEConnection(address=args.ble)
    return SerialConnection(args.port, 115200)

def ts():
    return datetime.now().strftime('%H:%M:%S')

def decode_hop_snr(path_hex: str) -> float | None:
    if len(path_hex) == 2:
        v = int(path_hex, 16)
        return (v if v < 128 else v - 256) / 4.0
    return None

async def do_trace(mc: MeshCore, path: str, timeout_extra: float = 5.0,
                   verbose: bool = False) -> tuple[bool, list[float]]:
    """
    Send a trace and return (reachable, [hop_snrs]).

    Uses TRACE_DATA events, which the firmware emits only when the trace reaches
    the end of its path (all relay hops forwarded). This makes false positives
    from intermediate relay retransmissions impossible by design.

    In verbose mode, also watches RX_LOG_DATA to show per-hop progress as the
    trace propagates (each relay's retransmission is visible to our local radio).
    """
    hops = path.split(',')
    seen_path_lens = set()
    t0 = asyncio.get_event_loop().time()

    result = await mc.commands.send_trace(path=path)
    if result.type == EventType.ERROR:
        return False, []

    expected_ack_bytes = result.payload['expected_ack']  # 4-byte tag
    trace_tag = int.from_bytes(expected_ack_bytes, 'little')
    timeout_s = result.payload.get('suggested_timeout', 10000) / 1000 + timeout_extra

    if verbose:
        print(f'  path: {" -> ".join(hops)}  (timeout {result.payload.get("suggested_timeout")}ms)')

    async def on_rx_log(event):
        p = event.payload
        if p.get('payload_typename') != 'TRACE':
            return
        if not p.get('pkt_payload', b'').startswith(expected_ack_bytes):
            return
        path_hex = p.get('path', '')
        n_hops = len(path_hex) // 2
        if n_hops in seen_path_lens:
            return
        seen_path_lens.add(n_hops)
        snrs = [decode_hop_snr(path_hex[i:i+2]) for i in range(0, len(path_hex), 2)]
        snrs = [s for s in snrs if s is not None]
        elapsed = asyncio.get_event_loop().time() - t0
        def hop_name(h):
            c = mc.get_contact_by_key_prefix(h)
            return c['adv_name'] if c else h
        path_so_far = ' -> '.join(hop_name(h) for h in hops[:n_hops]) if n_hops else '(direct)'
        snr_str = f'SNR {snrs[-1]:.2f} dB' if snrs else ''
        print(f'  +{elapsed:.2f}s  hop {n_hops}/{len(hops)}  {path_so_far}  rssi={p.get("rssi")} dBm  {snr_str}', flush=True)

    sub_rx = mc.subscribe(EventType.RX_LOG_DATA, on_rx_log) if verbose else None
    try:
        trace_event = await mc.wait_for_event(
            EventType.TRACE_DATA,
            attribute_filters={'tag': trace_tag},
            timeout=timeout_s,
        )
    finally:
        if sub_rx is not None:
            mc.unsubscribe(sub_rx)

    if trace_event is None:
        return False, []

    path_nodes = trace_event.payload.get('path', [])
    hop_snrs = [n['snr'] for n in path_nodes if 'snr' in n]
    return len(hop_snrs) >= len(hops), hop_snrs

async def cmd_set_txpower(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    si = mc.self_info
    current = si.get('tx_power', '?')
    result = await mc.commands.set_tx_power(args.value)
    if result.type == EventType.ERROR:
        print(f'ERROR: {result.payload}')
    else:
        print(f'TX power: {current} dBm -> {args.value} dBm')
    await mc.disconnect()


async def cmd_list(args):
    import glob
    from bleak import BleakScanner

    # Serial devices
    ports = sorted(glob.glob('/dev/ttyUSB*') + glob.glob('/dev/ttyACM*'))
    if ports:
        print('Serial:')
        for port in ports:
            try:
                cx = SerialConnection(port, 115200)
                mc = MeshCore(cx)
                await mc.connect()
                name = mc.self_info.get('name', '?')
                await mc.disconnect()
                print(f'  {port}  —  {name}')
            except Exception:
                print(f'  {port}  —  (no response)')
    else:
        print('Serial: none found')

    # BLE devices
    UART_SERVICE_UUID = '6e400001-b5a3-f393-e0a9-e50e24dcca9e'
    try:
        print('BLE (scanning 5s)...')
        devices = await BleakScanner.discover(timeout=5.0, service_uuids=[UART_SERVICE_UUID])
        if devices:
            print('BLE:')
            for d in devices:
                print(f'  {d.address}  —  {d.name or "?"}')
        else:
            print('BLE: none found')
    except Exception:
        print('BLE: unavailable (Bluetooth service not running)')


async def cmd_advert(args):
    cx = make_connection(args)
