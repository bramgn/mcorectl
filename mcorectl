async def cmd_neighbours(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    relay = mc.get_contact_by_key_prefix(args.key_prefix)
    if relay is None:
        print(f'ERROR: no contact matching {args.key_prefix!r} — try rxlog to catch its advert first')
        await mc.disconnect()
        return

    print(f'[{ts()}] Querying neighbour table of {relay["adv_name"]} ({relay["public_key"][:8]})...')
    result = await mc.commands.fetch_all_neighbours(relay, pubkey_prefix_length=8)
    if not result:
        print('No response from relay.')
        await mc.disconnect()
        return

    neighbours = result.get('neighbours', [])
    if not neighbours:
        print('Relay responded but reported no neighbours.')
    else:
        print(f'  {"pubkey":<20}  {"SNR":>7}  last heard')
        for n in sorted(neighbours, key=lambda x: x['secs_ago']):
            age = n['secs_ago']
            age_str = f'{age//60}m{age%60:02d}s ago'
            contact = mc.get_contact_by_key_prefix(n['pubkey'])
            name = f'  ({contact["adv_name"]})' if contact else ''
            print(f'  {n["pubkey"]:<20}  {n["snr"]:>5} dB  {age_str}{name}')

    await mc.disconnect()


async def cmd_trace(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    print(f'[{ts()}] Tracing {args.path}...')
    reachable, hop_snrs = await do_trace(mc, args.path, verbose=args.verbose)

    if reachable:
        snr_str = '  ->  '.join(f'{s:.2f} dB' for s in hop_snrs)
        print(f'[{ts()}] REACHABLE — hop SNRs: {snr_str}')
    else:
        print(f'[{ts()}] No reply.')

    await mc.disconnect()
    return 0 if reachable else 1

def main():
    parser = argparse.ArgumentParser(description='MeshCore trace and monitor tool')
    parser.add_argument('--port', default=DEFAULT_PORT, help=f'Serial port (default: {DEFAULT_PORT})')
    parser.add_argument('--ble', metavar='ADDRESS', help='Connect via BLE (MAC address, e.g. 3C:0F:02:E5:B7:F1)')

    sub = parser.add_subparsers(dest='cmd', required=True)

    p_adv = sub.add_parser('advert', help='Send an advertisement from the local node')
    p_adv.add_argument('--flood', action='store_true', help='Flood advert (default: zero-hop)')

    sub.add_parser('list', help='List available MeshCore devices (serial and BLE)')
    sub.add_parser('contacts', help='List all contacts')
    sub.add_parser('channels', help='List available channels')
    p_chan_send = sub.add_parser('channel-send', help='Send a message to a channel')
    p_chan_send.add_argument('idx', type=int, help='Channel index (see: meshctl channels)')
    p_chan_send.add_argument('message', help='Message text')

    p_status = sub.add_parser('status', help='Fetch status from a remote node')
    p_status.add_argument('key_prefix', help='Public key prefix of target node')

    p_telem = sub.add_parser('telemetry', help='Fetch telemetry from a remote node')
    p_telem.add_argument('key_prefix', help='Public key prefix of target node')

    p_path = sub.add_parser('route', help='Discover the mesh route to a contact')
    p_path.add_argument('key_prefix', help='Public key prefix of target node')

    p_adm = sub.add_parser('admin', help='Login to a remote node and run a command (advert, reboot, …)')
    p_adm.add_argument('key_prefix', help='Public key prefix of target node')
    p_adm.add_argument('admin_cmd', metavar='command', help='Command to send (e.g. advert, reboot, set key value)')
    p_adm.add_argument('--password', required=True, help='Admin password')

    sub.add_parser('info', help='Show local node identity (name, key, battery, uptime)')
    sub.add_parser('stats', help='Show local node radio and packet statistics')
    p_txp = sub.add_parser('set-txpower', help='Set local node TX power in dBm')
    p_txp.add_argument('value', type=int, help='TX power in dBm (e.g. 1–22)')

    p_send = sub.add_parser('send', help='Send a message to a contact')
    p_send.add_argument('key_prefix', help='Public key prefix of recipient, e.g. 01e9af70')
    p_send.add_argument('message', help='Message text')

    sub.add_parser('recv', help='Fetch and print all pending messages')

    sub.add_parser('listen', help='Live message monitor (Ctrl+C to stop)')

    p_rxlog = sub.add_parser('rxlog', help='Live RX packet log (Ctrl+C to stop)')
    p_rxlog.add_argument('--log', metavar='FILE', help='Also write output to this file')

    p_nb = sub.add_parser('neighbours', help='Fetch neighbour table from a relay (proves end-to-end reachability)')
    p_nb.add_argument('key_prefix', help='Public key prefix of the relay, e.g. 64')

    p_trace = sub.add_parser('trace', help='Send a trace and print result; exits 0 if reachable, 1 if not')
    p_trace.add_argument('path', help='Comma-separated hop bytes, e.g. 78,64,78 (include return path)')
    p_trace.add_argument('-v', '--verbose', action='store_true', help='Show each hop as it arrives')

    args = parser.parse_args()
    logging.basicConfig(level=logging.WARNING)

    import sys
    try:
        if args.cmd == 'advert':
            asyncio.run(cmd_advert(args))
        elif args.cmd == 'list':
            asyncio.run(cmd_list(args))
        elif args.cmd == 'contacts':
            asyncio.run(cmd_contacts(args))
        elif args.cmd == 'channels':
            asyncio.run(cmd_channels(args))
        elif args.cmd == 'channel-send':
            asyncio.run(cmd_channel_send(args))
        elif args.cmd == 'status':
            asyncio.run(cmd_status(args))
        elif args.cmd == 'telemetry':
            asyncio.run(cmd_telemetry(args))
        elif args.cmd == 'route':
            asyncio.run(cmd_route(args))
        elif args.cmd == 'admin':
            asyncio.run(cmd_admin(args))
        elif args.cmd == 'set-txpower':
            asyncio.run(cmd_set_txpower(args))
        elif args.cmd == 'info':
            asyncio.run(cmd_info(args))
        elif args.cmd == 'stats':
            asyncio.run(cmd_stats(args))
        elif args.cmd == 'send':
            asyncio.run(cmd_send(args))
        elif args.cmd == 'recv':
            asyncio.run(cmd_recv(args))
        elif args.cmd == 'listen':
            asyncio.run(cmd_listen(args))
        elif args.cmd == 'rxlog':
            asyncio.run(cmd_rxlog(args))
        elif args.cmd == 'neighbours':
            asyncio.run(cmd_neighbours(args))
        elif args.cmd == 'trace':
            sys.exit(asyncio.run(cmd_trace(args)) or 0)
    except KeyboardInterrupt:
        pass

if __name__ == '__main__':
    main()
