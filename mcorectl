async def cmd_send(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    contact = mc.get_contact_by_key_prefix(args.key_prefix)
    if contact is None:
        print(f'ERROR: no contact matching {args.key_prefix}')
        await mc.disconnect()
        return

    print(f'[{ts()}] Sending to {contact["adv_name"]}: {args.message!r}')
    result = await mc.commands.send_msg(contact, args.message)
    if result.type == EventType.MSG_SENT:
        print(f'[{ts()}] Sent.')
    else:
        print(f'[{ts()}] Failed: {result.type} {result.payload}')
    await mc.disconnect()


async def cmd_recv(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    count = 0
    while True:
        result = await mc.commands.get_msg()
        if result.type == EventType.NO_MORE_MSGS:
            break
        if result.type == EventType.CONTACT_MSG_RECV:
            p = result.payload
            sender_key = p.get('pubkey_prefix', '?')
            contact = mc.get_contact_by_key_prefix(sender_key)
            name = contact['adv_name'] if contact else sender_key
            print(f'[{p.get("sender_timestamp", "?")}] {name} ({sender_key[:8]}): {p.get("text", "")}')
            count += 1
        elif result.type == EventType.CHANNEL_MSG_RECV:
            p = result.payload
            idx = p.get('channel_idx', '?')
            print(f'[{p.get("sender_timestamp", "?")}] [ch{idx}] {p.get("text", "")}')
            count += 1

    if count == 0:
        print('No pending messages.')
    await mc.disconnect()


async def cmd_listen(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    print(f'[{ts()}] Listening for messages (Ctrl+C to stop)...', flush=True)

    # First drain any buffered messages
    while True:
        result = await mc.commands.get_msg()
        if result.type == EventType.NO_MORE_MSGS:
            break
        if result.type == EventType.CONTACT_MSG_RECV:
            p = result.payload
            sender_key = p.get('pubkey_prefix', '')
            contact = mc.get_contact_by_key_prefix(sender_key)
            name = contact['adv_name'] if contact else sender_key
            print(f'[buffered] {name} ({sender_key[:8]}): {p.get("text", "")}')

    def on_msg(event):
        p = event.payload
        sender_key = p.get('pubkey_prefix', '')
        contact = mc.get_contact_by_key_prefix(sender_key)
        name = contact['adv_name'] if contact else sender_key
        print(f'[{ts()}] {name} ({sender_key[:8]}): {p.get("text", "")}', flush=True)

    def on_chan(event):
        p = event.payload
        idx = p.get('channel_idx', '?')
        print(f'[{ts()}] [ch{idx}] {p.get("text", "")}', flush=True)

    mc.subscribe(EventType.CONTACT_MSG_RECV, on_msg)
    mc.subscribe(EventType.CHANNEL_MSG_RECV, on_chan)
    await mc.start_auto_message_fetching()

    try:
        while True:
            await asyncio.sleep(1)
    except (KeyboardInterrupt, asyncio.CancelledError):
        pass

    await mc.disconnect()


async def cmd_rxlog(args):
    cx = make_connection(args)
    mc = MeshCore(cx)
    await mc.connect()
    await mc.ensure_contacts()

    logfile = open(args.log, 'a') if args.log else None

    def log(line):
        print(line, flush=True)
        if logfile:
            print(line, file=logfile, flush=True)

    log(f'[{ts()}] RX log started (Ctrl+C to stop)...')

    def format_path(path_hex: str) -> str:
        if not path_hex:
            return ''
        snrs = []
        for i in range(0, len(path_hex), 2):
            v = int(path_hex[i:i+2], 16)
            snrs.append(f'{(v if v < 128 else v - 256) / 4.0:.2f}dB')
        return '  hops: ' + ' -> '.join(snrs)

    def on_rx(event):
        p = event.payload
        ptype  = p.get('payload_typename', '?')
        rssi   = p.get('rssi', '?')
        snr    = p.get('snr', '?')
        path   = p.get('path', '')
        extra  = ''

        if ptype == 'ADVERT':
            name = p.get('adv_name') or '?'
            if name == '?':
                adv_key = p.get('adv_key', '')
                contact = mc.get_contact_by_key_prefix(adv_key[:8]) if adv_key else None
                name = contact['adv_name'] if contact else adv_key[:8] or '?'
            via = ''
            if path:
                relay = mc.get_contact_by_key_prefix(path[:8])
                via = f'  via: {relay["adv_name"] if relay else path}'
            extra = f'  from: {name}{via}'

        elif ptype == 'TEXT_MSG':
            pkt = p.get('pkt_payload', b'')
            try:
                text = pkt[32:].split(b'\x00')[0].decode('utf-8', errors='replace')
                extra = f'  text: {text!r}'
            except Exception:
                pass

        elif ptype == 'TRACE':
            extra = format_path(path)

        elif ptype == 'ACK':
            extra = f'  ack: {path}'

        path_str = format_path(path) if ptype not in ('TRACE', 'ACK', 'ADVERT') and path else ''
        log(f'[{ts()}] {ptype:<12s}  rssi={rssi:>4} dBm  snr={snr:>5} dB{extra}{path_str}')

    mc.subscribe(EventType.RX_LOG_DATA, on_rx)

    try:
        while True:
            await asyncio.sleep(1)
    except (KeyboardInterrupt, asyncio.CancelledError):
        pass
    finally:
        if logfile:
            logfile.close()
    await mc.disconnect()


